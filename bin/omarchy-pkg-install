#!/bin/bash

# Source the package installation wrapper
source ~/.local/share/omarchy/install/preflight/package-install.sh

fzf_args=(
  --multi
  --preview 'echo "alt-p: toggle description, alt-j/k: scroll, F11: maximize"; echo; yay -Sii {1}'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
)

pkg_name=$(yay -Slq | fzf "${fzf_args[@]}")

if [[ -n "$pkg_name" ]]; then
  omarchy_install_packages "$pkg_name"
  sudo updatedb
  omarchy-show-done
fi
